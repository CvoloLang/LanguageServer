<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cvolo-language-server</AssemblyName>
    <RootNamespace>Cvolo.LanguageServer</RootNamespace>
    <ServerName>cvolo-language-server</ServerName>
  </PropertyGroup>

  <!-- Tooling location is produced by build/fetch-tooling.ps1|.sh. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\artifacts\tooling-dir.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\tooling-dir.props')" />

  <!--
    Embed tooling metadata into the assembly so the runtime can report the
    tooling version and compiler compatibility line without touching the
    artifacts directory (for example when printing version info).
  -->
  <Target Name="EmitToolingMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'$(CvoloToolingVersion)' != ''">
    <ItemGroup>
      <AssemblyMetadata Include="ToolingVersion" Value="$(CvoloToolingVersion)" />
      <AssemblyMetadata Include="CompilerCompatibilityLine" Value="$(CompilerCompatLine)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" Version="17.2.8" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

</Project>
